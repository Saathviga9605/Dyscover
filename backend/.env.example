# Local development settings for running the API directly (uvicorn). Copy to backend/.env.
APP_ENV=development
# SQLite is fine for development; production uses PostgreSQL, e.g.
#   postgresql+psycopg://dyscover:PASSWORD@localhost:5432/dyscover
DATABASE_URL=sqlite:///./dyscover.db
# Optional in development (a clearly-marked dev-only key is used if empty).
SECRET_KEY=
CORS_ORIGINS=http://localhost:5173

# Lexi (optional)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional local speech recognition for the speech demo (see docs/speech-architecture.md):
# DYSCOVER_ASR_PROVIDER=faster-whisper | huggingface-whisper
# DYSCOVER_ASR_MODEL=small
# DYSCOVER_ASR_ALLOW_MODEL_LOAD=true
