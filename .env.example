# Copy to .env (never commit .env). Used by docker-compose.yml.

# PostgreSQL password for the bundled database container.
POSTGRES_PASSWORD=

# JWT signing key, >= 32 random characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The API refuses to start in production with an empty or placeholder value.
SECRET_KEY=

# Public origin the browser uses (scheme + host + port). Must match exactly for CORS.
PUBLIC_ORIGIN=http://localhost:8080
WEB_PORT=8080

# Refresh-token cookies are Secure (HTTPS-only) in production. Set to false ONLY for a
# plain-HTTP local trial on localhost; never on a real deployment.
REFRESH_COOKIE_SECURE=true

# Lexi (optional). Without a key Lexi reports that it is not configured.
# Messages typed to Lexi are sent to Groq to generate replies.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
